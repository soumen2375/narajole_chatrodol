{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/[...route]"
    },
    {
      "source": "/events/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebook|WhatsApp|whatsapp|Twitter|LinkedIn|Telegram|Discord|Slack|Google|bingbot|applebot|SkypeUriPreview|meta|bot|crawler|spider|facebookexternalhit).*"
        }
      ],
      "destination": "/api/[...route]?match=share&slug=:slug"
    },
    {
      "source": "/posts/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebook|WhatsApp|whatsapp|Twitter|LinkedIn|Telegram|Discord|Slack|Google|bingbot|applebot|SkypeUriPreview|meta|bot|crawler|spider|facebookexternalhit).*"
        }
      ],
      "destination": "/api/[...route]?match=share&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/[...route]?match=sitemap"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
