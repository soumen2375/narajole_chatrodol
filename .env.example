# Copy to .env for local development (this file is NOT committed).
# All values below are PUBLIC (the anon key is protected by Row-Level Security).
# On Vercel/Netlify, set these in the host's Environment Variables instead.

# Optional — the app already falls back to the project's public values in code.
VITE_SUPABASE_URL=https://wzquszbmbpkbhyythdrj.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_7sZQXGDGxGl9M7yEl0UXpg_o0JLwp-L

# Razorpay public key id (key_id only — the key_secret is NEVER set here).
# The key_secret must be set as a Supabase Edge Function secret (see README).
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Cashfree Payment Gateway credentials (server-side only — NEVER expose secret on client)
# Obtain from: https://merchant.cashfree.com/merchants/developers
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_API_ENV=sandbox
# For production set: CASHFREE_API_ENV=production

# Frontend Cashfree mode (controls SDK mode: sandbox | production)
VITE_CASHFREE_MODE=sandbox

# Resend Email API credentials
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Chhatradol Social Welfare Organization <donations@chhatradol.org>
RESEND_REPLY_TO=info@chhatradol.org

# Sender for the secretary's letterpad. Official letters go out from the
# organisation's own mailbox, not the donations sender used for receipts.
# Optional — the code defaults to exactly this value.
LETTER_FROM_EMAIL=Chhatradol Social Welfare Organization <info@chhatradol.org>

# Site Base URL
SITE_URL=https://chhatradol.org
